# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소에 올리지 않는다.
# Claude API 키 (한국어 요약용). 없으면 화면에 "설정 필요"로 표시되고 원문 정보만 보인다.
ANTHROPIC_API_KEY=
# 번역·요약 모델 (기본 claude-haiku-5-5). 문체가 부족하면 claude-sonnet-5-5 로 올린다(요금 약 20배).
LLM_MODEL=
# 붙여 넣은 본문을 요약하는 모델 (기본 claude-sonnet-5-5). 기사당 한 번 호출한다.
LLM_BODY_MODEL=
# 같은 사건 묶기 모델 (기본 claude-sonnet-5-5). 수집당 한두 번만 호출한다.
LLM_GROUP_MODEL=
# 하루 Claude 사용 추정 금액 한도, 달러 (기본 0.5). 넘으면 자동 요약·묶기를 멈춘다. 0 이면 한도 없음.
DAILY_BUDGET_USD=
# 0 이면 한국어 기사는 다시 쓰지 않고 원래 제목 그대로 둔다. 기본은 문체 규칙대로 다시 쓴다.
SUMMARIZE_KOREAN=
# 0 이면 수집 직후 추천 기사를 자동으로 한국어 요약하지 않는다(버튼으로만 요약). 기본은 자동.
AUTO_SUMMARIZE=
# 1 이면 가상 데이터로 화면을 채우는 데모 모드. 실제 수집과 섞이지 않는다.
DEMO=
# 데이터 저장 위치 (기본 ./data)
DATA_DIR=
